# Copy to .env (git-ignored) and fill in. Never commit the real key.

# Provider for screenshot reading: gemini | anthropic | auto (default auto:
# Gemini if GEMINI_API_KEY is set, else Anthropic if ANTHROPIC_API_KEY is set).
GHOST_LLM_PROVIDER=auto

# Google Gemini (free tier key from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternative: Anthropic
ANTHROPIC_API_KEY=
# Optional: model used for screenshot reading (default claude-haiku-5-5)
GHOST_LLM_MODEL=claude-haiku-5-5
